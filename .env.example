# Copy to .env (git-ignored) and fill in your own API-Sports.io key.
# Get one free at https://dashboard.api-football.com/register
API_KEY=your_api_sports_key_here

# --- AI curation (spec sections 5-6) ---
# Which AiProvider implementation to use. Only "openrouter" exists today;
# see lib/data/services/ai/ai_provider_factory.dart to add another.
AI_PROVIDER=openrouter

# Get a free key at https://openrouter.ai/keys. If this is left blank,
# curation silently falls back to the rule-based FootballImportance
# scorer — the app still works, it just won't use an LLM to rank fixtures.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any OpenRouter model id. Defaults to a free Qwen instruct model if unset;
# check https://openrouter.ai/models?max_price=0 for the current free slug.
AI_MODEL=qwen/qwen-2.5-72b-instruct:free
