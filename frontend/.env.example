# Copy to .env.local (git-ignored) and fill in your own values.

# The existing Flask backend (backend/), same one the Flutter app uses.
VITE_API_BASE_URL=http://localhost:5050

# API-Sports.io key — see the SECURITY NOTE at the top of
# src/services/footballApi.ts before shipping this to production.
# Get one free at https://dashboard.api-football.com/register
VITE_FOOTBALL_API_KEY=your_api_sports_key_here
